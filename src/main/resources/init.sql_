sql

DROP TABLE IF EXISTS purchase_history_items CASCADE;
DROP TABLE IF EXISTS purchase_history CASCADE;
DROP TABLE IF EXISTS cart_items CASCADE;
DROP TABLE IF EXISTS carts CASCADE;
DROP TABLE IF EXISTS products CASCADE;
DROP TABLE IF EXISTS users CASCADE;

CREATE TABLE users (
    id VARCHAR(36) NOT NULL,
    username VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL,
    is_vip BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT pk_users PRIMARY KEY (id),
    CONSTRAINT uq_users_username UNIQUE (username),
    CONSTRAINT uq_users_email UNIQUE (email)
);

-- Products Table
CREATE TABLE products (
    id VARCHAR(36) NOT NULL,
    name VARCHAR(100) NOT NULL,
    price NUMERIC(12, 2) NOT NULL,
    sku VARCHAR(50) NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT pk_products PRIMARY KEY (id),
    CONSTRAINT uq_products_sku UNIQUE (sku),
    CONSTRAINT chk_products_price CHECK (price >= 0.00)
);

-- ============================================================================
-- 2. TRANSIENT SHOPPING CART SYSTEM TABLES
-- ============================================================================

-- Carts Table (Enforced Cart Type and Status via Check Constraints for PG 11)
CREATE TABLE carts (
    id VARCHAR(36) NOT NULL,
    user_id VARCHAR(36) NOT NULL,
    type VARCHAR(20) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT pk_carts PRIMARY KEY (id),
    CONSTRAINT fk_carts_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT chk_carts_type CHECK (type IN ('NORMAL', 'VIP')),
    CONSTRAINT chk_carts_status CHECK (status IN ('ACTIVE', 'COMPLETED', 'ABANDONED'))
);

-- Cart Items Table (Many-to-Many Bridge with Quantity)
CREATE TABLE cart_items (
    id VARCHAR(36) NOT NULL,
    cart_id VARCHAR(36) NOT NULL,
    product_id VARCHAR(36) NOT NULL,
    quantity INTEGER NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT pk_cart_items PRIMARY KEY (id),
    CONSTRAINT fk_cart_items_cart FOREIGN KEY (cart_id) REFERENCES carts(id) ON DELETE CASCADE,
    CONSTRAINT fk_cart_items_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,
    CONSTRAINT uq_cart_product UNIQUE (cart_id, product_id),
    CONSTRAINT chk_cart_items_quantity CHECK (quantity > 0)
);

-- ============================================================================
-- 3. IMMUTABLE PURCHASE HISTORY TABLES (For the Purchase Query Engine)
-- ============================================================================

-- Historical Purchases Header Table
CREATE TABLE purchase_history (
    id VARCHAR(36) NOT NULL,
    user_id VARCHAR(36) NOT NULL,
    cart_id VARCHAR(36) NOT NULL,
    total_paid NUMERIC(12, 2) NOT NULL,
    purchased_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT pk_purchase_history PRIMARY KEY (id),
    CONSTRAINT fk_purchase_history_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT,
    CONSTRAINT chk_purchase_history_total CHECK (total_paid >= 0.00)
);

-- Historical Purchase Items Line-Level Table
-- Protects data integrity by storing the exact price at the time of purchase
CREATE TABLE purchase_history_items (
    id VARCHAR(36) NOT NULL,
    purchase_id VARCHAR(36) NOT NULL,
    product_id VARCHAR(36) NOT NULL,
    product_name VARCHAR(100) NOT NULL,
    historical_price NUMERIC(12, 2) NOT NULL,
    quantity INTEGER NOT NULL,
    CONSTRAINT pk_purchase_history_items PRIMARY KEY (id),
    CONSTRAINT fk_history_items_header FOREIGN KEY (purchase_id) REFERENCES purchase_history(id) ON DELETE CASCADE,
    CONSTRAINT fk_history_items_product FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE SET NULL,
    CONSTRAINT chk_history_items_price CHECK (historical_price >= 0.00),
    CONSTRAINT chk_history_items_qty CHECK (quantity > 0)
);

-- ============================================================================
-- 4. PERFORMANCE & BUSINESS QUERY OPTIMIZATION INDEXES
-- ============================================================================

-- Fast lookup for checking active/inactive user sessions
CREATE INDEX idx_carts_user_status ON carts(user_id, status);

-- Speed up item alterations inside mutations
CREATE INDEX idx_cart_items_cart_id ON cart_items(cart_id);

-- Primary indexing for the historical data search
CREATE INDEX idx_purchase_history_user_search ON purchase_history(user_id);

-- CORE ENGINE STRATEGY INDEX: Custom optimized index for the analytical "Top 4 Most Expensive Items" query
CREATE INDEX idx_purchase_history_items_query_engine
ON purchase_history_items(purchase_id, historical_price DESC, product_id);

-- ============================================================================
-- 5. AUTOMATIC TIMESTAMP UPDATE TRIGGERS
-- ============================================================================

-- PL/pgSQL function to seamlessly update modification fields
CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Apply state tracking automation rules across domain entities
CREATE TRIGGER update_users_modtime BEFORE UPDATE ON users FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_products_modtime BEFORE UPDATE ON products FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_carts_modtime BEFORE UPDATE ON carts FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE TRIGGER update_cart_items_modtime BEFORE UPDATE ON cart_items FOR EACH ROW EXECUTE PROCEDURE update_modified_column();